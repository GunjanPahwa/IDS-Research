# Network Intrusion Detection System (NIDS) API Configuration

# Default dataset model key when not explicitly passed in request:
# Available options: kdd99 | nsl_kdd | unsw_nb15 | cic_ids2017 | cse_cic_ids2018 | uwf_zeekdata24
DEFAULT_DATASET=unsw_nb15

# Maximum allowed flows in a single POST /api/v1/predict/batch request
MAX_BATCH_SIZE=1000

# Base directory path for repository artifacts
ARTIFACTS_DIR=.

# Directories relative to ARTIFACTS_DIR
MODELS_DIR=models
PREPROCESSORS_DIR=data/preprocessors

# System logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
